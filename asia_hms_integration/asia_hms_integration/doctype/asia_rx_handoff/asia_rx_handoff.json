{
 "doctype": "DocType",
 "name": "ASIA Rx Handoff",
 "module": "ASIA HMS Integration",
 "custom": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "field_order": [
  "source_encounter",
  "clinic_company",
  "pharmacy_company",
  "patient",
  "patient_name",
  "practitioner",
  "created_at",
  "status",
  "quantity_reviewed_by",
  "quantity_reviewed_at",
  "quantity_review_note",
  "items"
 ],
 "fields": [
  {
   "fieldname": "source_encounter",
