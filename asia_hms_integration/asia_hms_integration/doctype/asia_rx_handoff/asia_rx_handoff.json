   "label": "Source Patient Encounter",
   "options": "Patient Encounter",
   "reqd": 1,
   "unique": 1,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "clinic_company",
   "fieldtype": "Link",
   "label": "Clinic Company",
   "options": "Company",
   "reqd": 1,
   "read_only": 1
  },
  {
   "fieldname": "pharmacy_company",
   "fieldtype": "Link",
   "label": "Pharmacy Company",
   "options": "Company",
   "reqd": 1,
   "read_only": 1
  },
  {
   "fieldname": "patient",
   "fieldtype": "Link",
   "label": "Patient",
   "options": "Patient",
   "reqd": 1,
   "read_only": 1
  },
  {
   "fieldname": "patient_name",
   "fieldtype": "Data",
   "label": "Patient Name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "practitioner",
   "fieldtype": "Link",
   "label": "Prescribing Practitioner",
   "options": "Healthcare Practitioner",
   "read_only": 1
  },
  {
   "fieldname": "created_at",
   "fieldtype": "Datetime",
   "label": "Prescription Submitted At",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Pending\nQuantity Reviewed\nPartly Dispensed\nDispensed\nCancelled\nReview Required",
   "default": "Pending",
   "in_list_view": 1
  },
  {
   "fieldname": "quantity_reviewed_by",
   "fieldtype": "Link",
   "label": "Quantity Reviewed By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "quantity_reviewed_at",
   "fieldtype": "Datetime",
   "label": "Quantity Reviewed At",
   "read_only": 1
  },
  {
   "fieldname": "quantity_review_note",
   "fieldtype": "Small Text",
   "label": "Pharmacist Review Note",
   "read_only": 1
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Prescribed Medicines",
   "options": "ASIA Rx Item",
   "reqd": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "create": 1,
   "read": 1,
   "write": 1,
   "delete": 1,
   "print": 1,
   "report": 1
  },
  {
   "role": "ASIA Pharmacist",
   "read": 1,
   "print": 1,
   "report": 1
  }
 ],
 "links": [],
 "states": [],
 "track_changes": 1,
 "autoname": "format:ASIA-RX-{YYYY}-{#####}",
